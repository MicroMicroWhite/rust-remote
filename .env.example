# Project-wide environment overrides. Keep client-related settings here when
# needed; a separate .env.client file is not used.
# Empty credentials are generated and saved on first startup.
ADMIN_PASSWORD=
AGENT_TOKEN=
ENTRANCE_CODE=
HTTP_PORT=8080
COOKIE_SECURE=false
UV_IMAGE=astral/uv:python3.11-bookworm-slim
BUN_IMAGE=oven/bun:1.3.14-alpine
NGINX_IMAGE=nginx:alpine
RUST_IMAGE=rust:1.90-slim-bookworm
HTTP_PROXY=http://host.docker.internal:7897
HTTPS_PROXY=http://host.docker.internal:7897
# Optional package mirrors; leave empty to use official sources.
APT_MIRROR=
CARGO_MIRROR=
RUSTUP_MIRROR=
CLOUDFLARED_TUNNEL_TOKEN=
TUNNEL_HOSTNAME=
